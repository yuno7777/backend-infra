# Backend Infra environment example -- copy to .env and fill in.
# NEVER commit .env. setup_local_postgres.ps1 writes DATABASE_URL for you.

# PostgreSQL (local portable cluster default from scripts/dev/setup_local_postgres.ps1)
DATABASE_URL=postgresql+psycopg://backend_infra:CHANGE_ME@127.0.0.1:54329/backend_infra
# Test database (created by setup script on the same cluster)
TEST_DATABASE_URL=postgresql+psycopg://backend_infra:CHANGE_ME@127.0.0.1:54329/backend_infra_test

# Token hashing pepper (REQUIRED for auth; generate: python -c "import secrets; print(secrets.token_hex(32))")
TOKEN_HASH_PEPPER=CHANGE_ME

# Secret used for webhook signing key derivation (REQUIRED in Phase 6)
WEBHOOK_SIGNING_KEY=CHANGE_ME

# Runtime
LOG_FORMAT=console            # console | json
LOG_LEVEL=INFO
API_PORT=8080
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# Rate limiting (per user, fixed window, in-process; see docs/OBSERVABILITY.md)
RATE_LIMIT_DEFAULT_PER_MIN=120
RATE_LIMIT_LOGIN_PER_MIN=10

# Jobs
JOB_DEFAULT_TIMEOUT_SECONDS=300
JOB_DEFAULT_MAX_ATTEMPTS=3
JOB_PACKET_BYTES_MAX=1000000  # request body cap (bytes)

# Idempotency
IDEMPOTENCY_KEY_TTL_HOURS=24
IDEMPOTENCY_REPLAY=true

# Data directory for report artifacts (relative to repo root; gitignored)
DATA_DIR=data
